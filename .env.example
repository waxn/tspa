# Dev: uv run python -m app.set_password  (prints the PASSWORD_HASH line). Docker: see README, no hash needed here.
PASSWORD_HASH=
SECRET_KEY=change-me
HTTPS_ONLY=false   # true when served over HTTPS
TZ=America/New_York
DATABASE_URL=sqlite:///./tspa.db

# Optional AI: summarises, tags and suggests where a captured thought belongs. Any OpenAI-compatible API works.
# OpenRouter (default). Use a :free model id to keep it free.
AI_API_KEY=
AI_MODEL=
# Self-hosted instead (Ollama / LM Studio on your own machine, no key needed):
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_MODEL=llama3.2
AI_DAILY_LIMIT=40

# Token for the phone / scripts: curl -H "Authorization: Bearer $API_TOKEN" -d '{"text":"call mom in 2h"}' .../api/capture
# Needs 24+ characters or it is ignored. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Web Push (generate VAPID keys with: uv run python -m app.gen_vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
