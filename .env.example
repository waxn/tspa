# Dev: uv run python -m app.set_password  (prints the PASSWORD_HASH line). Docker: see README, no hash needed here.
PASSWORD_HASH=
SECRET_KEY=change-me
HTTPS_ONLY=false   # true when served over HTTPS
TZ=America/New_York
DATABASE_URL=sqlite:///./tspa.db
# Optional AI fallback (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Web Push (generate VAPID keys later)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
